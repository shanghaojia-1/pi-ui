{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "useDefineForClassFields": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["node", "vite/client"],
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["src/shared/*"],
      "@renderer/*": ["src/renderer/src/*"],
      "@earendil-works/pi-agent-core": ["node_modules/@earendil-works/pi-coding-agent/node_modules/@earendil-works/pi-agent-core"],
      "@earendil-works/pi-ai": ["node_modules/@earendil-works/pi-coding-agent/node_modules/@earendil-works/pi-ai"],
      "typebox": ["node_modules/@earendil-works/pi-coding-agent/node_modules/typebox"]
    }
  },
  "include": ["src", "extensions/**/*.ts", "electron.vite.config.ts", "tests"]
}
