{
  "name": "pi-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A focused desktop GUI for Pi coding agent",
  "license": "MIT",
  "keywords": [
    "electron",
    "pi",
    "coding-agent",
    "gui"
  ],
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "icons": "node scripts/generate-icons.mjs",
    "dist": "npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder",
    "dist:mac": "npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --arm64",
    "dist:win": "npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win --x64",
    "dist:linux": "npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --linux --x64 -c.directories.output=release/linux",
    "dist:all": "npm run build && node scripts/build-all.mjs",
    "verify:artifacts": "node scripts/verify-artifacts.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.83.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@electron/asar": "^4.2.1",
    "@playwright/test": "^1.51.0",
    "@resvg/resvg-js": "^2.6.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "cross-env": "^10.1.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "build": {
    "appId": "com.earendilworks.pistudio",
    "productName": "Pi Studio",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "artifactName": "Pi-Studio-${version}-${os}-${arch}.${ext}",
    "files": [
      "out/**",
      "package.json",
      "!**/.pi/**",
      "!**/auth*.json",
      "!**/sessions/**"
    ],
    "asar": true,
    "asarUnpack": [
      "**/*.node",
      "**/*.wasm"
    ],
    "npmRebuild": false,
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "zip"
      ],
      "identity": null,
      "notarize": false,
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "Pi Studio"
    },
    "win": {
      "target": [
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "Pi-Studio-${version}-win-${arch}-portable.${ext}"
    },
    "linux": {
      "category": "Development",
      "maintainer": "ligang <ligang_ahyf@smec-cn.com>",
      "executableName": "pi-studio",
      "synopsis": "A focused desktop GUI for Pi coding agent",
      "syncDesktopName": true,
      "target": [
        "AppImage"
      ]
    },
    "appImage": {
      "artifactName": "Pi-Studio-${version}-linux-x64.${ext}"
    },
    "deb": {
      "artifactName": "Pi-Studio-${version}-linux-x64.${ext}"
    }
  },
  "allowScripts": {
    "@google/genai@1.52.0": true,
    "protobufjs@7.6.5": true,
    "electron-winstaller@5.4.0": true,
    "esbuild@0.25.12": true
  }
}
